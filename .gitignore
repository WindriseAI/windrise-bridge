# 运行数据（登录态、令牌、激活信息）
data/
build/seed/

# 依赖与构建产物
node_modules/
dist/
_release-tmp/
build/bin/
# 浏览器安装包（Chromium mini_installer，约 160 MB）：只进 NSIS 安装包，不进仓库
build/browser/

# 改代码前的备份（里面有旧版代码和预置凭据）

# 密钥、口令、激活码、数据库：绝不进仓库
**/*.pem
**/.env*
**/*.csv

# 探针运行产物

# 2026-10-25 建本地仓库时补的
data.safe-shell-*/
data.*/
*.bak-*
**/owner-auth.json*
**/route-token.json*

# 本 worktree 的一次性验收脚本与数据（真机实测用，不入库）
.tmp/e2e-flow/

server/
.env
.env.*
*.key
*.p12
*.pfx
*.sqlite
*.sqlite3
*.db
